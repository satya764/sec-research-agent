# Copy to .env and fill in. Never commit .env.

# --- Answering model: pick ONE block ---
# Free, runs on your Mac with Ollama (install from ollama.com, then: ollama pull qwen3:8b)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:11434/v1
CHEAP_MODEL=qwen3:8b
STRONG_MODEL=qwen3:8b
JUDGE_MODEL=qwen3:8b

# Claude (paid, more accurate): comment out the block above and fill these in
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# CHEAP_MODEL=claude-haiku-5-5
# STRONG_MODEL=claude-sonnet-5-5
# JUDGE_MODEL=claude-haiku-5-5

# Optional: better ranking. Without it, results skip the rerank step.
COHERE_API_KEY=
# SEC requires your name and email
SEC_USER_AGENT=Your Name you@example.com
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sec_agent

# Embeddings run locally for free. To use OpenAI instead, uncomment these 4 lines,
# then run: uv run sec-agent init-db --reset
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
# OPENAI_API_KEY=

RETRIEVAL_MODE=hybrid_rerank

# Optional: Phoenix tracing (uv sync --extra tracing, then run Phoenix)
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
