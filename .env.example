# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: better ranking. Without it, results skip the rerank step.
COHERE_API_KEY=
# SEC requires your name and email
SEC_USER_AGENT=Your Name you@example.com
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sec_agent

CHEAP_MODEL=claude-haiku-5-5
STRONG_MODEL=claude-sonnet-5-5
RETRIEVAL_MODE=hybrid_rerank

# Optional: Phoenix tracing (uv sync --extra tracing, then run Phoenix)
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
